{
  "name": "recanet-typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recanet backend TypeScript SDK",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "native",
    "scripts/build-native.mjs",
    "tools/greenfield/worker.cjs",
    "tools/greenfield/package.json",
    "tools/greenfield/package-lock.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:native && tsc -p tsconfig.json",
    "build:native": "node scripts/build-native.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test && npm run test:greenfield",
    "test:greenfield": "npm --prefix tools/greenfield test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ethers": "6.17.0"
  }
}
