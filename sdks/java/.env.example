# Public Privy app ID and server-only app secret (injected by the host application).
PRIVY_APP_ID=YOUR_PRIVY_APP_ID
PRIVY_APP_SECRET=YOUR_PRIVY_APP_SECRET

# Set ONE verification source and construct PrivyTokenVerificationConfig accordingly.
# Copy this app's trusted JWKS URL from the Privy Dashboard.
PRIVY_JWKS_URL=
# Offline alternative: SPKI PEM public key, passed as an environment value with real newlines.
PRIVY_VERIFICATION_KEY_PEM=

# This SDK does not automatically load .env files.

# DMRVN: explicit testnet partner settings; never put private keys in source control.
# Examples default to the approved proxy. Use direct-v7 only for historical reads/recovery.
DMRVN_DEPLOYMENT=proxy
# Optional explicit approved manifest path for diagnostics/PET examples; no fallback on failure.
DMRVN_DEPLOYMENT_MANIFEST=
DMRVN_APPROVER_WALLET_ID=y2hl7bcafkz4aapnw36dykav
DMRVN_APPROVER_ADDRESS=0xf288EC9EcC516a7E4C6780b417f3a247fE20cC77
# APPROVER above is the single operating wallet for provenance, Claim approval and Relay.
# No default: obtain the new Evidence wire version/support confirmation from the DMRVN operator.
DMRVN_EVIDENCE_SCHEMA_VERSION=
DMRVN_BENEFICIARY=0xeA9ecC2F4D32E075e961Afffd522bbf88BBA40a9
# Absolute Node >=22 executable used by NodeGreenfieldStorage.
DMRVN_NODE_PATH=
# Dedicated Greenfield signer; EVM signing remains in Privy.
GREENFIELD_STORAGE_PRIVATE_KEY=
# Optional operator-provided public Feegrant granter address.
GREENFIELD_FEE_GRANTER=0x812EA1e3fb2EFA004AE1308ed27EcEd0b05Cae66
