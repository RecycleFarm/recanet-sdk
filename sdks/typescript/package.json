{
  "name": "@recyclefarm/recanet-sdk",
  "version": "0.1.0-rc.2",
  "type": "module",
  "description": "Recanet backend TypeScript SDK",
  "engines": {
    "node": ">=22 <23"
  },
  "files": [
    "dist",
    "prebuilds",
    "THIRD_PARTY_NOTICES",
    "tools/greenfield/worker.cjs",
    "tools/greenfield/package.json",
    "tools/greenfield/package-lock.json",
    "tools/greenfield/vendor/elliptic/package.json",
    "tools/greenfield/vendor/elliptic/LICENSE",
    "tools/greenfield/vendor/elliptic/lib",
    "tools/greenfield/vendor/safe-set/package.json",
    "tools/greenfield/vendor/safe-set/index.cjs",
    "scripts/install-native.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && npm run build:native && tsc -p tsconfig.json",
    "build:native": "node scripts/build-native.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test && npm run test:greenfield",
    "test:greenfield": "npm --prefix tools/greenfield test",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "test:security": "npm --prefix tools/greenfield run test:security",
    "install": "node scripts/install-native.mjs",
    "prepack": "node scripts/check-prebuilds.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@hpke/chacha20poly1305": "1.8.1",
    "@hpke/core": "1.10.1",
    "ethers": "6.17.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RecycleFarm/recanet-sdk.git",
    "directory": "sdks/typescript"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
