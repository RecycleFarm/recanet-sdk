# Public Privy app ID and server-only app secret (injected by the host application).
PRIVY_APP_ID=YOUR_PRIVY_APP_ID
PRIVY_APP_SECRET=YOUR_PRIVY_APP_SECRET

# Set ONE verification source and construct PrivyTokenVerificationConfig accordingly.
# Copy this app's trusted JWKS URL from the Privy Dashboard.
PRIVY_JWKS_URL=
# Offline alternative: SPKI PEM public key, passed as an environment value with real newlines.
PRIVY_VERIFICATION_KEY_PEM=

# This SDK does not automatically load .env files.
